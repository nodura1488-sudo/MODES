{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TMStore",
  "version": "0.4.36",
  "identifier": "gg.tm.store",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TMStore",
        "width": 380,
        "height": 620,
        "minWidth": 360,
        "minHeight": 520,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "backgroundColor": "#080808",
        "shadow": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "TM",
    "shortDescription": "TMStore",
    "longDescription": "TMStore — магазин режимов Minecraft с поддержкой аккаунтов Ely.by",
    "copyright": "© TM",
    "category": "Game",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
